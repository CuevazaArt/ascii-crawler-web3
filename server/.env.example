# Leak Runner operator API — environment
# Copy to .env (never commit .env). On Render/Railway set these in the dashboard.
# Run: npm run dev   (node --env-file-if-exists=.env src/index.mjs)

# 'testnet' for QA, 'mainnet' for the real launch
XRPL_NETWORK=testnet

# Operator hot wallet secret. THE ONLY SECRET THAT MOVES XRP.
# Accepts either:
#   - classic family seed: sXXXX... / sEdXXXX...
#   - Xaman Secret Numbers: 8 groups of 6 digits (quote them):
#       XRPL_OPERATOR_SEED="123456 234567 345678 456789 567890 678901 789012 890123"
#   testnet → faucet / Xaman testnet account
#   mainnet → fund 20-50 XRP; keep the bulk cold
XRPL_OPERATOR_SEED=

# Optional: override the websocket node (defaults per network)
# XRPL_WSS=wss://xrplcluster.com

# HTTP port
PORT=8787

# Comma-separated origins allowed by CORS (empty = allow all, dev only).
# Must match the exact origin of the game page (scheme + host + port).
# Local static server defaults to :8765 — also register these at apps.xaman.dev.
# ALLOWED_ORIGINS=https://cuevazaart.github.io
ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765

# Set to 1 when running behind a proxy/load balancer (Render, Railway, nginx)
# so rate limiting sees the real client IP from X-Forwarded-For
TRUST_PROXY=0

# Safety rails
DAILY_PAYOUT_CAP_XRP=100
LOW_BALANCE_ALERT_XRP=10

# Epoch prizes: 0 = queue for manual approval via /api/admin/approve (recommended at launch)
AUTO_EPOCH_PAYOUT=0

# Token for /api/admin endpoints (empty = a random one is generated and logged at boot)
ADMIN_TOKEN=

# HMAC secret for run tokens (empty = derived from the operator seed)
RUN_TOKEN_SECRET=

# SQLite file (folder auto-created). On Render attach a persistent disk here.
DB_FILE=data/leakrunner.db
